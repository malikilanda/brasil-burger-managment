@page
@model BrasilBurger.Pages.Client.CatalogueBurgerModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brasil Burger - Catalogue</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Itim&family=Hanken+Grotesk:wght@400;700&family=Poppins:wght@400;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home bb-catalogue">
    <div class="container-fluid px-0">
        <div class="min-vh-100 bb-page">

            <header class="bb-nav px-4 px-lg-5 pt-4">
                <nav class="d-flex justify-content-end gap-4 gap-lg-5 flex-wrap">
                    <a class="bb-nav-link" href="/Client/Acceuil">Acceuil</a>
                    <a class="bb-nav-link active" href="/Client/CatalogueBurger">Catalogue</a>
                    <a class="bb-nav-link" href="/Client/Panier">Panier</a>
                    <a class="bb-nav-link" href="/Client/MesCommandes">Commandes</a>
                </nav>
            </header>

            <section class="px-4 px-lg-5 mt-4">
                <div class="bb-tabs d-flex gap-3 flex-wrap">
                    <a class="bb-tab active" href="/Client/CatalogueBurger">Burger</a>
                    <a class="bb-tab" href="/Client/CatalogueFrite">Frites</a>
                    <a class="bb-tab" href="/Client/CatalogueBoisson">boisson</a>
                    <a class="bb-tab" href="/Client/CatalogueMenu">menu</a>
                </div>
            </section>

            <section class="px-4 px-lg-5 py-4">
                <div class="row g-4">
                    @foreach (var b in Model.Items)
                    {
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="bb-card h-100">
                                <div class="bb-card-img">
                                    <img src="@(string.IsNullOrWhiteSpace(b.Image)
                                                 ? Url.Content("~/images/burger.png")
                                                 : Url.Content("~/" + b.Image))" alt="@b.Name" />
                                </div>


                                <div class="bb-card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <h3 class="bb-card-title">@b.Name</h3>
                                        <span class="bb-card-price">@b.Price.ToString("0") FCFA</span>
                                    </div>
                                    <p class="bb-card-desc">
                                        pain, laitue,<br>tomate, steak,<br>fromage, oignon
                                    </p>
                                </div>

                                <div class="bb-card-footer">
                                    <a class="bb-add" asp-page="/Client/DetailsProduits" asp-route-type="BURGER"
                                        asp-route-id="@b.Id">+</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>