@page
@model BrasilBurger.Pages.Client.MesCommandesModel
@{
    Layout = null;
    var backUrl = "/Client/CatalogueBurger";
}

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brasil Burger - Mes commandes</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home bb-orderspage">

    <!-- Back vers CatalogueBurger -->
    <a href="@backUrl" class="bb-back-btn">Retour</a>

    <main class="bb-mock container-fluid">

        <!-- NAV TOP (comme ton design) -->
        <header class="bb-nav px-4 px-lg-5 pt-4">
            <nav class="d-flex justify-content-end gap-4 gap-lg-5 align-items-center">

                <a class="bb-nav-link" href="/Client/acceuil">Acceuil</a>
                <a class="bb-nav-link" href="/Client/catalogueburger">Catalogue</a>
                <a class="bb-nav-link" href="/Client/panier">Panier</a>
                <a class="bb-nav-link active" href="/Client/mescommandes">Commandes</a>

                <!-- MENU COMPTE -->
                <div class="bb-nav-account">
                    <span class="bb-nav-link">Compte ▾</span>

                    <div class="bb-account-dropdown">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/Logout">Déconnexion</a>
                        }
                        else
                        {
                            <a href="/Index">Connexion</a>
                            <a href="/Register">Inscription</a>
                        }
                    </div>
                </div>

            </nav>
        </header>


        <section class="bb-orders-wrap">
            <h1 class="bb-orders-title">Mes commandes</h1>

            <div class="bb-orders-table">
                <div class="bb-orders-head">
                    <div>Mes commandes</div>
                    <div>Statut</div>
                    <div>Livraison</div>
                    <div>Mes commandes</div>
                </div>

                @if (Model.Items.Count == 0)
                {
                    <div class="bb-orders-row">
                        <div>—</div>
                        <div>—</div>
                        <div class="bb-green">—</div>
                        <div>Aucune commande</div>
                    </div>
                }
                else
                {
                    foreach (var it in Model.Items)
                    {
                        <div class="bb-orders-row">
                            <div>Commandes #@it.Id</div>
                            <div>@it.StatusLabel</div>
                            <div class="bb-green">@it.DeliveryLabel</div>
                            <div>@it.Note</div>
                        </div>
                    }
                }
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>