@page
@model BrasilBurger.Pages.Client.AcceuilModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brasil Burger - Accueil</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Polices (comme ton HTML) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Itim&family=Hanken+Grotesk:wght@400;700&display=swap" rel="stylesheet">

    <!-- CSS perso (Razor) -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home">

    <div class="container-fluid p-0">
        <div class="row g-0 min-vh-100">

            <!-- Image à gauche -->
            <div class="col-12 col-lg-6 bb-home-left">
                <img src="~/images/burger.png" class="bb-home-img" alt="Burger" />
            </div>

            <!-- Contenu à droite -->
            <div class="col-12 col-lg-6 bb-home-right d-flex flex-column">

                <!-- Navbar -->
                <header class="bb-nav px-4 px-lg-5 pt-4">
                    <nav class="d-flex justify-content-end gap-4 gap-lg-5">
                        <a class="bb-nav-link active" href="/Client/acceuil">Acceuil</a>
                        <a class="bb-nav-link" href="/Client/catalogueburger">Catalogue</a>
                        <a class="bb-nav-link" href="/Client/panier">Panier</a>
                        <a class="bb-nav-link" href="/Client/mescommandes">Commandes</a>
                    </nav>
                </header>

                <!-- Hero -->
                <section class="bb-hero px-4 px-lg-5 d-flex flex-column justify-content-center flex-grow-1">
                    <h1 class="bb-title mb-3">BRASIL BURGER</h1>

                    <p class="bb-desc mb-4">
                        Les meilleurs burgers du Brésil à portée de clic ! <br />
                        Découvrez notre catalogue de burgers savoureux, <br />
                        menus complets (burger + frites + boisson) et <br />
                        compléments gourmands.
                    </p>

                    <div>
                        <a href="/Client/catalogueburger" class="btn bb-btn-pill">
                            en savoir plus
                        </a>
                    </div>
                </section>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
