@page
@model BrasilBurger.Pages.Client.DetailsProduitsModel
@{
    Layout = null;
    var backUrl = Model.Type?.ToUpper() == "MENU" ? "/Client/CatalogueMenu" : "/Client/CatalogueBurger";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brasil Burger - Détails Produit</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home bb-detailspage">
    <a href="@backUrl" class="bb-back-btn">← Retour</a>

    <main class="bb-mock container-fluid">

        <header class="bb-details-nav d-flex justify-content-end gap-5 flex-wrap">
            <a class="bb-nav-link" href="/Client/acceuil">Acceuil</a>
            <a class="bb-nav-link" href="/Client/catalogueburger">Catalogue</a>
            <a class="bb-nav-link" href="/Client/panier">Panier</a>
            <a class="bb-nav-link" href="/Client/mescommandes">Commandes</a>
        </header>

        <div class="bb-details-hero">
            <img src="@Model.Image" alt="@Model.Title" class="bb-details-burger" id="productImage">
        </div>

        <section class="bb-details-panel">
            <h1 class="bb-details-title" id="productTitle">@Model.Title</h1>

            <p class="bb-details-desc" id="productDesc">@Model.Desc</p>
<!-- MODES DE COMMANDE -->
<div class="bb-details-modes">

    <label class="bb-mode">
        <input type="radio" name="OrderType" value="LIVRAISON" checked>
        <div class="bb-mode-ui">
            <div class="bb-mode-pill">✓</div>
            <div class="bb-mode-label">Livraison</div>
        </div>
    </label>

    <label class="bb-mode">
        <input type="radio" name="OrderType" value="SUR_PLACE">
        <div class="bb-mode-ui">
            <div class="bb-mode-pill">⌂</div>
            <div class="bb-mode-label">Sur place</div>
        </div>
    </label>

    <label class="bb-mode">
        <input type="radio" name="OrderType" value="EMPORTER">
        <div class="bb-mode-ui">
            <div class="bb-mode-pill">⇪</div>
            <div class="bb-mode-label">Emporter</div>
        </div>
    </label>

</div>

            <form method="post" asp-page-handler="Add">
                <input type="hidden" name="OrderType" id="orderTypeInput" value="LIVRAISON" />
                <input type="hidden" asp-for="Type" />
                <input type="hidden" asp-for="Id" />

                <!-- EXTRAS (uniquement si BURGER) -->
                @if (Model.Type?.ToUpper() != "MENU")
                {
                    <div class="bb-extras">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="bb-extra-label" for="selectFrite">Frites</label>
                                <select id="selectFrite" class="bb-extra-select" asp-for="FritesId">
                                    <option value="">Aucune</option>
                                    @foreach (var f in Model.Frites)
                                    {
                                        <option value="@f.Id" data-price="@f.Price">@f.Name - @f.Price.ToString("0") FCFA</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="bb-extra-label" for="selectBoisson">Boisson</label>
                                <select id="selectBoisson" class="bb-extra-select" asp-for="BoissonId">
                                    <option value="">Aucune</option>
                                    @foreach (var b in Model.Boissons)
                                    {
                                        <option value="@b.Id" data-price="@b.Price">@b.Name - @b.Price.ToString("0") FCFA</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="bb-summary mt-3" id="orderSummary"></div>
                    </div>
                }

                <div class="bb-details-bottom">
                    <div class="bb-qty">
                        <button type="button" class="bb-qty-btn" id="qtyPlus">+</button>
                        <span class="bb-qty-val" id="qtyVal">@Model.Qty</span>
                        <button type="button" class="bb-qty-btn" id="qtyMinus">-</button>
                        <input type="hidden" asp-for="Qty" id="qtyInput" />
                    </div>

                    <button type="submit" class="bb-add-big" id="btnAdd">
                        Ajouter <span id="priceText">0</span> FCFA
                    </button>

                    <div class="bb-menu-toggle" style="visibility:hidden">
                        <span class="bb-menu-label">menu</span>
                        <label class="bb-switch">
                            <input type="checkbox" id="toggleMenu">
                            <span class="bb-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="bb-pack" id="packInfo"></div>
            </form>
        </section>
    </main>

    <script>
        // ✅ Prix base vient du serveur (donc plus de NaN)
        const BASE_PRICE = Number("@Model.BasePrice".replace(",", "."));
        let qty = Number("@Model.Qty") || 1;

        const qtyVal = document.getElementById("qtyVal");
        const qtyInput = document.getElementById("qtyInput");
        const priceText = document.getElementById("priceText");

        const selectFrite = document.getElementById("selectFrite");
        const selectBoisson = document.getElementById("selectBoisson");
        const orderSummary = document.getElementById("orderSummary");

        function getSelectedPrice(selectEl){
            if(!selectEl) return 0;
            const opt = selectEl.options[selectEl.selectedIndex];
            const p = opt ? opt.getAttribute("data-price") : "0";
            return Number(String(p).replace(",", ".")) || 0;
        }

        function render(){
            const frPrice = getSelectedPrice(selectFrite);
            const boPrice = getSelectedPrice(selectBoisson);

            const unit = BASE_PRICE + frPrice + boPrice;
            const total = unit * qty;

            priceText.textContent = total.toLocaleString("fr-FR");
            qtyVal.textContent = qty;
            qtyInput.value = qty;

            if(orderSummary){
                orderSummary.innerHTML = `
                    <div>📦 <b>Résumé</b></div>
                    <div>💰 Total : <b>${total.toLocaleString("fr-FR")} FCFA</b> (x${qty})</div>
                `;
            }
        }

        document.getElementById("qtyPlus").addEventListener("click", () => { qty++; render(); });
        document.getElementById("qtyMinus").addEventListener("click", () => { qty = Math.max(1, qty - 1); render(); });

        if(selectFrite) selectFrite.addEventListener("change", render);
        if(selectBoisson) selectBoisson.addEventListener("change", render);

        render();
    </script>
    <script>
    // synchroniser le mode choisi avec le formulaire
    document.querySelectorAll('input[name="OrderType"]').forEach(radio => {
        radio.addEventListener('change', () => {
            document.getElementById("orderTypeInput").value = radio.value;
        });
    });
</script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
