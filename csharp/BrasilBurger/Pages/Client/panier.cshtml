@page
@model BrasilBurger.Pages.Client.PanierModel
@{
    Layout = null;
    var backUrl = "/Client/catalogueburger";
}

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brasil Burger - Panier</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home bb-panierpage">

    <a href="@backUrl" class="bb-back-btn">← Retour</a>

    <main class="bb-panier container-fluid">
        <div class="bb-panier-wrap">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <h1 class="bb-panier-title">votre panier</h1>
                <button class="bb-clear-cart" type="button" id="clearCart">Vider</button>
            </div>

            <section class="bb-panier-card" id="cartList"></section>

            <section class="bb-panier-footer">
                <div class="bb-panier-total">
                    <span>Total</span>
                    <strong id="cartTotalText">0 FCFA</strong>
                </div>

                <!-- Pour l’instant on redirige vers Paiement (design) -->
                <button class="bb-panier-pay" type="button" id="btnPay">Payer</button>
            </section>

        </div>
    </main>

    <script>
        // ⚠️ Panier fake (JS) juste pour le design.
        // En vrai, plus tard => C# + DB.

        function loadCart() {
            try { return JSON.parse(localStorage.getItem("bb_cart") || "[]"); }
            catch { return []; }
        }
        function saveCart(cart) {
            localStorage.setItem("bb_cart", JSON.stringify(cart));
        }
        function formatFCFA(n) {
            return (n || 0).toLocaleString("fr-FR") + " FCFA";
        }

        const cartList = document.getElementById("cartList");
        const cartTotalText = document.getElementById("cartTotalText");
        const btnClear = document.getElementById("clearCart");
        const btnPay = document.getElementById("btnPay");

        function renderCart() {
            const cart = loadCart();

            if (cart.length === 0) {
                cartList.innerHTML = `<div class="bb-empty">Panier vide.</div>`;
                cartTotalText.textContent = formatFCFA(0);
                return;
            }

            cartList.innerHTML = cart.map(item => {
                const extras = [
                    item.frite ? `🍟 ${item.frite.name}` : null,
                    item.boisson ? `🥤 ${item.boisson.name}` : null
                ].filter(Boolean).join(" • ");

                return `
          <div class="bb-panier-item-row">
            <div class="bb-panier-img">
              <img src="${item.image}" alt="${item.title}">
            </div>

            <div class="bb-panier-info">
              <div class="bb-panier-name">${item.title}</div>
              <div class="bb-panier-sub">${item.mode}${extras ? " • " + extras : ""}</div>
              <div class="bb-panier-price">${formatFCFA(item.unitPrice)}</div>
            </div>

            <div class="bb-panier-qty">
              <button class="bb-qty-btn" type="button" data-act="minus" data-key="${item.key}">-</button>
              <div class="bb-qty-val">${item.qty}</div>
              <button class="bb-qty-btn" type="button" data-act="plus" data-key="${item.key}">+</button>
            </div>

            <button class="bb-remove" type="button" data-act="remove" data-key="${item.key}">✕</button>
          </div>
        `;
            }).join("");

            const total = cart.reduce((s, x) => s + (x.unitPrice * x.qty), 0);
            cartTotalText.textContent = formatFCFA(total);
        }

        cartList.addEventListener("click", (e) => {
            const btn = e.target.closest("button");
            if (!btn) return;

            const act = btn.dataset.act;
            const key = btn.dataset.key;
            if (!act || !key) return;

            const cart = loadCart();
            const item = cart.find(x => x.key === key);
            if (!item) return;

            if (act === "plus") item.qty++;
            if (act === "minus") item.qty = Math.max(1, item.qty - 1);
            if (act === "remove") {
                const i = cart.findIndex(x => x.key === key);
                if (i !== -1) cart.splice(i, 1);
            }

            saveCart(cart);
            renderCart();
        });

        btnClear.addEventListener("click", () => {
            localStorage.removeItem("bb_cart");
            renderCart();
        });

        btnPay.addEventListener("click", () => {
            // Pour le moment => page paiement (design)
            window.location.href = "/Client/paiement";
        });

        renderCart();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>