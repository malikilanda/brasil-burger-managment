@page
@model BrasilBurger.Pages.Client.PanierModel
@{
    Layout = null;
    var backUrl = "/Client/catalogueburger";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brasil Burger - Panier</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home bb-panierpage">

<a href="@backUrl" class="bb-back-btn">← Retour</a>

<main class="bb-panier container-fluid">
    <div class="bb-panier-wrap">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <h1 class="bb-panier-title">votre panier</h1>

            <form method="post" asp-page-handler="Clear" class="m-0">
                <button class="bb-clear-cart" type="submit">Vider</button>
            </form>
        </div>

        <section class="bb-panier-card" id="cartList">
            @if (Model.Lines.Count == 0)
            {
                <div class="bb-empty">Panier vide.</div>
            }
            else
            {
                foreach (var item in Model.Lines)
                {
                    <div class="bb-panier-item-row">
                        <div class="bb-panier-img">
                            <img src="@item.Image" alt="@item.Title">
                        </div>

                        <div class="bb-panier-info">
                            <div class="bb-panier-name">@item.Title</div>
                            <div class="bb-panier-sub">@item.Sub</div>
                            <div class="bb-panier-price">@item.UnitPrice.ToString("N0") FCFA</div>
                        </div>

                        <div class="bb-panier-qty">
                            <form method="post" asp-page-handler="Minus" class="m-0">
                                <input type="hidden" name="key" value="@item.Key" />
                                <button class="bb-qty-btn" type="submit">-</button>
                            </form>

                            <div class="bb-qty-val">@item.Qty</div>

                            <form method="post" asp-page-handler="Plus" class="m-0">
                                <input type="hidden" name="key" value="@item.Key" />
                                <button class="bb-qty-btn" type="submit">+</button>
                            </form>
                        </div>

                        <form method="post" asp-page-handler="Remove" class="m-0">
                            <input type="hidden" name="key" value="@item.Key" />
                            <button class="bb-remove" type="submit">✕</button>
                        </form>
                    </div>
                }
            }
        </section>

        <section class="bb-panier-footer">
            <div class="bb-panier-total">
                <span>Total</span>
                <strong>@Model.Total.ToString("N0") FCFA</strong>
            </div>

            <button onclick="window.location.href = '/Client/paiement';" class="bb-panier-pay" type="button">Payer</button>
        </section>

    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
