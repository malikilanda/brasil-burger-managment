@page
@model BrasilBurger.Pages.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Inscription";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inscription</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body class="bb-home">
    <main class="bb-login-page">

        <!-- IMAGE À GAUCHE (tu peux garder ou enlever) -->
        <div class="bb-login-left">
            <img src="~/images/burger.png" class="bb-login-burger" alt="Burger" />
        </div>

        <!-- FORM À DROITE -->
        <div class="bb-login-right">

            <div class="bb-login-toplink">
                <span>déjà un compte ?</span>
                <a href="/Index" class="bb-link-strong">connecte toi</a>
            </div>

            <form class="bb-login-form" method="post">
                <input class="bb-input" asp-for="Firstname" placeholder="prénom" required />
                <input class="bb-input" asp-for="Lastname" placeholder="nom" required />
                <input class="bb-input" asp-for="Phone" placeholder="téléphone" required />
                <input class="bb-input" asp-for="Password" type="password" placeholder="mot de passe" required />

                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="mt-3 alert alert-danger p-2">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="mt-3 alert alert-success p-2">@Model.SuccessMessage</div>
                }

                <button class="bb-login-submit" type="submit">
                    Créer mon compte
                </button>
            </form>

        </div>
    </main>
</body>
</html>
