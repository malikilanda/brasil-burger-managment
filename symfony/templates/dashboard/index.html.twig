{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<h1 class="page-title">Dashboard</h1>

<div class="cards">
    <div class="card">
        <p class="card-label">Commandes en cours :</p>
        <p class="card-value">05</p>
    </div>

    <div class="card">
        <p class="card-label">Validée :</p>
        <p class="card-value">10</p>
    </div>

    <div class="card">
        <p class="card-label">Burgers vendus :</p>
        <p class="card-value">20</p>
    </div>

    <div class="card">
        <p class="card-label">Validée :</p>
        <p class="card-value">10</p>
    </div>

    <div class="card card-wide">
        <p class="card-label">Recettes :</p>
        <p class="card-value">100000 FCFA</p>
    </div>
</div>

<div class="section-header">
    <h2 class="section-title">Commandes recentes</h2>
    <a href="/commande" class="see-more">Voir plus</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Client</th>
            <th>Montant</th>
            <th>Etat</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>1</td>
            <td>Malik LO</td>
            <td>4500 Fcfa</td>
            <td><span class="badge badge-green">validée</span></td>
        </tr>
        <tr>
            <td>2</td>
            <td>Awa BA</td>
            <td>4500 Fcfa</td>
            <td><span class="badge badge-green">attente</span></td>
        </tr>
        <tr>
            <td>3</td>
            <td>Oumou LO</td>
            <td>4500 Fcfa</td>
            <td><span class="badge badge-green">validée</span></td>
        </tr>
    </tbody>
</table>
{% endblock %}