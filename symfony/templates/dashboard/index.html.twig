{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="layout">

    <main class="content">
        <div class="topbar">
            <div class="page-title">Dashboard</div>
        </div>

        <div class="cards">
            <div class="card">
                <div class="card-label">Total commandes</div>
                <div class="card-value">{{ stats.totalOrders|default(0) }}</div>
            </div>
            <div class="card">
                <div class="card-label">En attente / en cours</div>
                <div class="card-value">{{ stats.pendingOrders|default(0) }}</div>
            </div>
            <div class="card">
                <div class="card-label">Terminées</div>
                <div class="card-value">{{ stats.doneOrders|default(0) }}</div>
            </div>
            <div class="card">
                <div class="card-label">Recettes</div>
                <div class="card-value">{{ stats.recettes|default(0)|number_format(0, '.', ' ') }} FCFA</div>
            </div>
        </div>

        <div class="cards">
            <div class="card">
                <div class="card-label">Burgers</div>
                <div class="card-value">{{ stats.totalBurgers|default(0) }}</div>
            </div>
            <div class="card">
                <div class="card-label">Menus</div>
                <div class="card-value">{{ stats.totalMenus|default(0) }}</div>
            </div>
            <div class="card">
                <div class="card-label">Compléments</div>
                <div class="card-value">{{ stats.totalComplements|default(0) }}</div>
            </div>
        </div>

        <div class="section">
            <div class="section-head">
                <div class="section-title">Commandes récentes</div>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Client</th>
                            <th>Téléphone</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for o in stats.recentOrders %}
                            <tr>
                                <td>#{{ o.id }}</td>
                                <td>
                                    {{ (o.client_firstname ~ ' ' ~ o.client_lastname)|trim ?: '—' }}
                                </td>
                                <td>{{ o.client_phone|default('—') }}</td>
                                <td>{{ o.type|default('—') }}</td>
                                <td>
                                    <span class="badge">{{ o.status|default('—') }}</span>
                                </td>
                                <td>{{ (o.total_amount ?? 0)|number_format(0, '.', ' ') }} FCFA</td>
                                <td>
                                    {% if o.created_at %}
                                        {{ o.created_at|date('d/m/Y H:i') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" style="text-align:center; opacity:.7;">
                                    Aucune commande trouvée.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>
{% endblock %}
