{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block body %}
<div class="layout">

  <main class="content">
    <h1 class="page-title">Commande</h1>

    <div class="section-head">
      <div class="section-title">Liste des commandes</div>
      <a class="section-more" href="#">Voir plus</a>
    </div>

    <table class="bb-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Client</th>
          <th>Téléphone</th>
          <th>Type</th>
          <th>Status</th>
          <th>Total</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
      {% for c in commandes %}
        <tr>
          <td>{{ c.id }}</td>
          <td>{{ c.client_nom|trim }}</td>
          <td>{{ c.client_phone }}</td>
          <td>
            <span class="badge badge-type">{{ c.type }}</span>
          </td>
          <td>
            {# Tu peux adapter les couleurs si tu veux #}
            <span class="badge badge-ok">{{ c.status }}</span>
          </td>
          <td>{{ c.total_amount }} Fcfa</td>
          <td>
            {% if c.created_at %}
              {{ c.created_at|date('Y-m-d H:i') }}
            {% else %}
              -
            {% endif %}
          </td>
          <td class="actions">
            <a class="btn btn-outline-blue" href="#">Voir</a>
            <a class="btn btn-outline-green" href="#">Valider</a>
            <a class="btn btn-outline-red" href="#">Supprimer</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="8">Aucune commande</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>

  </main>
</div>
{% endblock %}
